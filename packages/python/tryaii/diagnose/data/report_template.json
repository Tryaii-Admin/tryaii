{
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>tryaii diagnose — {{site_count}} sites</title>\n<style>\n  :root {\n    --bg: #0b0d10;\n    --panel: #14181d;\n    --panel-2: #1b2026;\n    --text: #e6e9ee;\n    --muted: #8a939d;\n    --line: #232932;\n    --ok: #6ee7b7;\n    --warn: #fcd34d;\n    --info: #93c5fd;\n  }\n  @media (prefers-color-scheme: light) {\n    :root { --bg:#fafbfc; --panel:#ffffff; --panel-2:#f4f6f9; --text:#0f1419; --muted:#5b6470; --line:#e6eaef; --ok:#059669; --warn:#b45309; --info:#2563eb; }\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text);\n    font: 14px/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif; }\n  main { max-width: 1100px; margin: 0 auto; padding: 32px 24px 64px; }\n  header.top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 8px; }\n  header.top h1 { font-size: 18px; margin: 0; font-weight: 600; letter-spacing: 0.2px; }\n  header.top h1 small { color: var(--muted); font-weight: 400; margin-left: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n  .meta { color: var(--muted); font-size: 12px; }\n  .goal { margin: 16px 0 0; padding: 10px 14px; border: 1px solid var(--line); border-left: 3px solid var(--info);\n    border-radius: 8px; background: var(--panel); font-size: 13px; }\n  .goal b { color: var(--info); font-weight: 600; }\n  .chips { display: flex; gap: 8px; margin: 16px 0 24px; flex-wrap: wrap; }\n  .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px;\n    background: var(--panel-2); border: 1px solid var(--line); font-size: 12px; color: var(--muted); }\n  .chip b { color: var(--text); font-weight: 600; }\n  .stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 24px; }\n  .stat { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }\n  .stat .k { font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); }\n  .stat .v { font-size: 20px; font-weight: 600; margin-top: 4px; }\n  .stat .v.warn { color: var(--warn); }\n  .stat .v.ok { color: var(--ok); }\n  .delta { margin: 0 0 24px; padding: 10px 14px; border: 1px solid var(--line); border-left: 3px solid var(--ok);\n    border-radius: 8px; background: var(--panel); font-size: 13px; }\n  .delta code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--muted); }\n  section { margin-bottom: 28px; }\n  section > h2 { font-size: 13px; letter-spacing: 0.4px; color: var(--muted); font-weight: 600; margin: 0 0 12px;\n    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 18px; }\n  table.counts { width: 100%; border-collapse: collapse; font-size: 13px; }\n  table.counts td, table.counts th { padding: 5px 8px; text-align: right; border-bottom: 1px dashed var(--line); font-variant-numeric: tabular-nums; }\n  table.counts tr:last-child td { border-bottom: 0; }\n  table.counts th { color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; }\n  table.counts td.name, table.counts th.name { text-align: left; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-bottom: 12px; }\n  .card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }\n  .card-head h3 { font-size: 14px; margin: 0; font-weight: 600; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n  .card-head .muted { font-size: 12px; }\n  .badges { display: flex; gap: 8px; flex-wrap: wrap; }\n  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;\n    border: 1px solid var(--line); font-size: 12px; background: var(--panel-2); color: var(--muted); }\n  .badge .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }\n  .badge.ok .dot { background: var(--ok); }\n  .badge.ok { color: var(--ok); border-color: var(--ok); }\n  .badge.finding .dot { background: var(--warn); }\n  .badge.finding { color: var(--warn); border-color: var(--warn); }\n  .badge.skipped { border-style: dashed; }\n  details { margin-top: 10px; border-top: 1px dashed var(--line); padding-top: 8px; }\n  details summary { cursor: pointer; font-size: 12px; color: var(--muted); font-weight: 600;\n    text-transform: uppercase; letter-spacing: 0.6px; }\n  details[open] summary { color: var(--text); }\n  .kv { list-style: none; margin: 8px 0 0; padding: 0; font-size: 13px; }\n  .kv li { display: flex; justify-content: space-between; gap: 16px; padding: 3px 0; border-bottom: 1px dashed var(--line); }\n  .kv li:last-child { border-bottom: 0; }\n  .kv .k { color: var(--muted); }\n  .kv .v { font-variant-numeric: tabular-nums; text-align: right; }\n  table.rank { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 8px; }\n  table.rank td, table.rank th { padding: 4px 8px; text-align: right; border-bottom: 1px dashed var(--line); font-variant-numeric: tabular-nums; }\n  table.rank th { color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; }\n  table.rank td.m, table.rank th.m { text-align: left; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n  table.rank tr.current td { color: var(--info); font-weight: 600; }\n  table.rank td.r { color: var(--muted); font-size: 11px; text-align: left; }\n  .bar { background: var(--panel-2); border-radius: 4px; height: 8px; overflow: hidden; margin-top: 6px; }\n  .bar-fill { display: block; height: 100%; background: linear-gradient(90deg, var(--ok), var(--info)); }\n  ul.findings { list-style: none; margin: 8px 0 0; padding: 0; font-size: 13px; }\n  ul.findings li { padding: 6px 0; border-bottom: 1px dashed var(--line); }\n  ul.findings li:last-child { border-bottom: 0; }\n  ul.findings .kind { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--warn); }\n  ul.findings .where { color: var(--muted); font-size: 12px; margin-left: 8px; }\n  ul.findings .excerpt { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px;\n    background: var(--panel-2); border-radius: 4px; padding: 1px 6px; margin-left: 8px; }\n  ul.findings .why { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }\n  ul.plain { list-style: none; margin: 8px 0 0; padding: 0; font-size: 13px; color: var(--muted); }\n  ul.plain li { padding: 3px 0; }\n  .muted { color: var(--muted); }\n  .reason { font-size: 12px; color: var(--muted); font-style: italic; }\n  footer { color: var(--muted); font-size: 12px; margin-top: 32px; display: flex; gap: 16px; flex-wrap: wrap; }\n  footer a { color: var(--info); text-decoration: none; }\n  footer a:hover { text-decoration: underline; }\n  @media (max-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }\n</style>\n</head>\n<body>\n<main>\n  <header class=\"top\">\n    <h1>tryaii diagnose <small>{{run_id}}</small></h1>\n    <span class=\"meta\">{{generated_at}} · tryaii {{tool_version}}</span>\n  </header>\n<!--BEGIN goal-->\n  <div class=\"goal\"><b>goal</b> {{text}}</div>\n<!--END goal-->\n\n  <div class=\"chips\">\n    <span class=\"chip\">quality <b>{{q}}</b></span>\n    <span class=\"chip\">cost <b>{{c}}</b></span>\n    <span class=\"chip\">speed <b>{{s}}</b></span>\n  </div>\n\n  <div class=\"stats\">\n    <div class=\"stat\"><div class=\"k\">Sites</div><div class=\"v\">{{site_count}}</div></div>\n    <div class=\"stat\"><div class=\"k\">Findings</div><div class=\"v{{findings_cls}}\">{{findings_total}}</div></div>\n    <div class=\"stat\"><div class=\"k\">Est. monthly cost</div><div class=\"v\">{{est_cost}}</div></div>\n    <div class=\"stat\"><div class=\"k\">Cache savings (max)</div><div class=\"v{{cache_savings_cls}}\">{{cache_savings}}</div></div>\n    <div class=\"stat\"><div class=\"k\">Swap savings</div><div class=\"v{{swap_savings_cls}}\">{{swap_savings}}</div></div>\n  </div>\n<!--BEGIN delta-->\n  <div class=\"delta\">since <code>{{prev_run_id}}</code>: {{improved}} site(s) improved, {{regressed}} regressed, {{added}} new, {{removed}} removed<!--BEGIN monthly--> · monthly est. {{value}}<!--END monthly--></div>\n<!--END delta-->\n\n  <section>\n    <h2>check status</h2>\n    <div class=\"panel\">\n      <table class=\"counts\">\n        <tr><th class=\"name\">check</th><th>ok</th><th>finding</th><th>insufficient</th><th>skipped</th></tr>\n<!--BEGIN status_rows-->\n        <tr><td class=\"name\">{{check}}</td><td>{{ok}}</td><td>{{finding}}</td><td>{{insufficient}}</td><td>{{skipped}}</td></tr>\n<!--END status_rows-->\n      </table>\n<!--BEGIN skipped-->\n      <details>\n        <summary>{{count}} site(s) skipped at intake</summary>\n        <ul class=\"plain\">\n<!--BEGIN items-->\n          <li>site #{{index}}: {{reason}}</li>\n<!--END items-->\n        </ul>\n      </details>\n<!--END skipped-->\n    </div>\n  </section>\n<!--BEGIN files-->\n\n  <section>\n    <h2>{{file}}</h2>\n<!--BEGIN sites-->\n    <article class=\"card\">\n      <header class=\"card-head\">\n        <h3>{{site_id}}</h3>\n        <span class=\"muted\">line {{line}} · model: {{model_label}}</span>\n      </header>\n      <div class=\"badges\">\n<!--BEGIN chips-->\n        <span class=\"badge {{cls}}\"><span class=\"dot\"></span>{{label}}: {{badge}}</span>\n<!--END chips-->\n      </div>\n<!--BEGIN reasons-->\n      <div class=\"reason\">{{label}}: {{text}}</div>\n<!--END reasons-->\n<!--BEGIN mf-->\n      <details>\n        <summary>model fit — {{summary}}</summary>\n        <ul class=\"kv\">\n          <li><span class=\"k\">category</span><span class=\"v\">{{category}}</span></li>\n          <li><span class=\"k\">confidence</span><span class=\"v\">{{confidence}}</span></li>\n        </ul>\n        <table class=\"rank\">\n          <tr><th>#</th><th class=\"m\">model</th><th>quality</th><th>cost</th><th>speed</th></tr>\n<!--BEGIN rows-->\n          <tr class=\"{{cls}}\"><td>{{rank}}</td><td class=\"m\">{{model_id}}</td><td>{{q}}</td><td>{{c}}</td><td>{{s}}</td></tr>\n          <tr class=\"{{cls}}\"><td></td><td class=\"r\" colspan=\"4\">{{reasoning}}</td></tr>\n<!--END rows-->\n        </table>\n      </details>\n<!--END mf-->\n<!--BEGIN cache-->\n      <details>\n        <summary>cache readiness — {{verdict_code}}</summary>\n        <p class=\"muted\" style=\"font-size:13px;margin:8px 0 0\">{{verdict_summary}}</p>\n        <ul class=\"kv\">\n          <li><span class=\"k\">total tokens</span><span class=\"v\">{{total_tokens}}</span></li>\n          <li><span class=\"k\">provider minimum</span><span class=\"v\">{{threshold}}</span></li>\n          <li><span class=\"k\">stable prefix</span><span class=\"v\">{{stable_tokens}} tok ({{stable_pct}}%)</span></li>\n        </ul>\n        <div class=\"bar\"><span class=\"bar-fill\" style=\"width:{{bar_width}}%\"></span></div>\n<!--BEGIN findings-->\n        <ul class=\"findings\">\n<!--BEGIN items-->\n          <li><span class=\"kind\">{{kind}}</span><span class=\"where\">{{where}}</span><span class=\"excerpt\">{{excerpt}}</span><span class=\"why\">{{why}}</span></li>\n<!--END items-->\n        </ul>\n<!--END findings-->\n<!--BEGIN recs-->\n        <ul class=\"plain\">\n<!--BEGIN items-->\n          <li>{{text}}</li>\n<!--END items-->\n        </ul>\n<!--END recs-->\n      </details>\n<!--END cache-->\n<!--BEGIN cost-->\n      <details>\n        <summary>cost exposure</summary>\n        <ul class=\"kv\">\n<!--BEGIN rows-->\n          <li><span class=\"k\">{{label}}</span><span class=\"v\">{{value}}</span></li>\n<!--END rows-->\n        </ul>\n      </details>\n<!--END cost-->\n<!--BEGIN hyg-->\n      <details>\n        <summary>hygiene — {{stats}}</summary>\n<!--BEGIN findings-->\n        <ul class=\"findings\">\n<!--BEGIN items-->\n          <li><span class=\"kind\">{{kind}}</span><span class=\"where\">{{where}}</span><span class=\"excerpt\">{{excerpt}}</span><span class=\"why\">{{hint}}</span></li>\n<!--END items-->\n        </ul>\n<!--END findings-->\n<!--BEGIN advisories-->\n        <ul class=\"plain\">\n<!--BEGIN items-->\n          <li>{{text}}</li>\n<!--END items-->\n        </ul>\n<!--END advisories-->\n      </details>\n<!--END hyg-->\n    </article>\n<!--END sites-->\n  </section>\n<!--END files-->\n\n  <footer>\n    <span>artifacts:</span>\n    <a href=\"findings.json\">findings.json</a>\n    <a href=\"inventory.json\">inventory.json</a>\n    <span>everything on this page was produced locally — nothing was sent anywhere.</span>\n  </footer>\n</main>\n</body>\n</html>\n"
}
