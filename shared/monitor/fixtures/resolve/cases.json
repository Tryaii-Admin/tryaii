    {
      "name": "policy-other-excludes-anchor",
      "description": "SPEC §2.8: an 'other' client can only send the anchor; a policy without it leaves no in-path candidate at all.",
      "input": {
        "base_url": "http://localhost:11434/v1",
        "model": "gpt-5.5",
        "policy_allowed": [
          "openai/gpt-5-mini"
        ]
      },
      "expected": {
        "provider": "other",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": [
          "openai/gpt-5.5"
        ],
        "native": "openai/gpt-5.5",
        "policy_allowed": [
          "openai/gpt-5-mini"
        ],
        "route_allowed": [],
        "shadow_allowed": [
