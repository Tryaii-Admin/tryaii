          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "native": "claude-sonnet-4.5",
        "policy_allowed": null,
        "route_allowed": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "shadow_allowed": null
      }
    },
    {
      "name": "host-without-scheme",
      "description": "A bare host is read as https://host.",
      "input": {
        "base_url": "openrouter.ai",
        "model": "x-ai/grok-4"
      },
      "expected": {
        "provider": "openrouter",
        "anchor": "x-ai/grok-4",
        "anchor_reachable": true,
        "allowed_models": null,
        "native": "x-ai/grok-4",
        "policy_allowed": null,
        "route_allowed": null,
        "shadow_allowed": null
      }
    },
    {
      "name": "no-model",
      "description": "A missing model has no anchor; the openai class still lists its reachable ids.",
      "input": {
        "base_url": "https://api.openai.com/v1",
        "model": null
      },
      "expected": {
        "provider": "openai",
        "anchor": null,
        "anchor_reachable": false,
        "allowed_models": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
