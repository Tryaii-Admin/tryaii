{
  "suite": "resolve",
  "target": "tryaii.monitor.winner.provider_class / resolve_anchor / allowed_models / native_model_id",
  "cases": [
    {
      "name": "openai-default-base-url",
      "description": "No base_url means api.openai.com; a bare native id resolves to the openai/ catalog id; allowed models = every openai/* id in catalog order.",
      "input": {
        "base_url": null,
        "model": "gpt-5.5"
      },
      "expected": {
        "provider": "openai",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "native": "gpt-5.5",
        "policy_allowed": null,
        "route_allowed": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "shadow_allowed": null
      }
    },
    {
      "name": "openai-explicit-base-url",
      "description": "api.openai.com with a versioned path is the openai class.",
      "input": {
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4o"
      },
      "expected": {
        "provider": "openai",
        "anchor": "openai/gpt-4o",
        "anchor_reachable": true,
        "allowed_models": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "native": "gpt-4o",
        "policy_allowed": null,
        "route_allowed": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "shadow_allowed": null
      }
    },
    {
      "name": "openrouter-reaches-everything",
      "description": "openrouter.ai is unfiltered (allowed_models null); the native id of a slug is the slug.",
      "input": {
        "base_url": "https://openrouter.ai/api/v1",
        "model": "openai/gpt-5.5"
      },
      "expected": {
        "provider": "openrouter",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": null,
        "native": "openai/gpt-5.5",
        "policy_allowed": null,
        "route_allowed": null,
        "shadow_allowed": null
      }
    },
    {
      "name": "azure-openai-is-other",
      "description": "*.openai.azure.com is not *.openai.com: class other, only the anchor is allowed.",
      "input": {
        "base_url": "https://myco.openai.azure.com/openai/v1",
        "model": "gpt-5.5"
      },
      "expected": {
        "provider": "other",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": [
          "openai/gpt-5.5"
        ],
        "native": "openai/gpt-5.5",
        "policy_allowed": null,
        "route_allowed": [
          "openai/gpt-5.5"
        ],
        "shadow_allowed": null
      }
    },
    {
      "name": "local-server-unknown-model",
      "description": "A local OpenAI-compatible server with a model outside the catalog: class other, no anchor, nothing allowed.",
      "input": {
        "base_url": "http://localhost:11434/v1",
        "model": "llama3.2"
      },
      "expected": {
        "provider": "other",
        "anchor": null,
        "anchor_reachable": false,
        "allowed_models": [],
        "native": null,
        "policy_allowed": null,
        "route_allowed": [],
        "shadow_allowed": null
      }
    },
    {
      "name": "dated-anthropic-id-on-openai-client",
      "description": "The anchor resolves through diagnose's alias rule even when the client class cannot reach it; the native id strips the namespace.",
      "input": {
        "base_url": null,
        "model": "claude-sonnet-4-5-20250929"
      },
      "expected": {
        "provider": "openai",
        "anchor": "anthropic/claude-sonnet-4.5",
        "anchor_reachable": false,
        "allowed_models": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
