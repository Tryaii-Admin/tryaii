          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "shadow_allowed": null
      }
    },
    {
      "name": "policy-openai-intersects-reachable",
      "description": "SPEC §2.8: an openai client with a policy -- the in-path candidates are reachable ∩ policy (catalog order); the shadow candidates are the whole policy list.",
      "input": {
        "base_url": null,
        "model": "gpt-5.5",
        "policy_allowed": [
          "anthropic/claude-haiku-4.5",
          "openai/gpt-5.5",
          "openai/gpt-5-mini"
        ]
      },
      "expected": {
        "provider": "openai",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "native": "gpt-5.5",
        "policy_allowed": [
          "anthropic/claude-haiku-4.5",
          "openai/gpt-5.5",
          "openai/gpt-5-mini"
        ],
        "route_allowed": [
          "openai/gpt-5-mini",
          "openai/gpt-5.5"
        ],
        "shadow_allowed": [
          "openai/gpt-5-mini",
          "openai/gpt-5.5",
          "anthropic/claude-haiku-4.5"
        ]
      }
    },
    {
      "name": "policy-openrouter-is-the-policy",
      "description": "SPEC §2.8: openrouter reaches everything, so both candidate lists are the policy's ids in catalog order.",
      "input": {
        "base_url": "https://openrouter.ai/api/v1",
        "model": "openai/gpt-5.5",
        "policy_allowed": [
          "openai/gpt-5-mini",
          "anthropic/claude-haiku-4.5"
        ]
      },
      "expected": {
        "provider": "openrouter",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": null,
        "native": "openai/gpt-5.5",
        "policy_allowed": [
          "openai/gpt-5-mini",
          "anthropic/claude-haiku-4.5"
        ],
        "route_allowed": [
          "openai/gpt-5-mini",
          "anthropic/claude-haiku-4.5"
        ],
        "shadow_allowed": [
          "openai/gpt-5-mini",
          "anthropic/claude-haiku-4.5"
        ]
      }
    },
    {
      "name": "policy-none-openrouter-unfiltered",
      "description": "SPEC §2.8: no policy and an openrouter client -- both requests are unfiltered (null).",
      "input": {
        "base_url": "https://openrouter.ai/api/v1",
        "model": "openai/gpt-5.5",
        "policy_allowed": null
      },
      "expected": {
        "provider": "openrouter",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": null,
        "native": "openai/gpt-5.5",
        "policy_allowed": null,
        "route_allowed": null,
        "shadow_allowed": null
      }
    },
    {
      "name": "policy-fails-closed-without-origins",
      "description": "SPEC §2.8: an active policy that cannot be evaluated (the starter bundle has no origins.json) allows nothing: both candidate lists are [].",
      "input": {
        "base_url": null,
        "model": "gpt-5.5",
        "policy": {
          "origin": "no-prc-models"
        }
      },
      "expected": {
        "provider": "openai",
        "anchor": "openai/gpt-5.5",
        "anchor_reachable": true,
        "allowed_models": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
          "openai/gpt-5-nano",
          "openai/gpt-4.1",
          "openai/gpt-5.1",
          "openai/gpt-5.2",
          "openai/gpt-5.4",
          "openai/gpt-5.4-mini",
          "openai/gpt-5.4-nano",
