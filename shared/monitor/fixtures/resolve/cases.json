          "openai/gpt-5.5",
          "openai/gpt-6-sol",
          "openai/gpt-oss-120b"
        ],
        "native": null,
        "policy_allowed": null,
        "route_allowed": [
          "openai/gpt-4o",
          "openai/gpt-4o-mini",
          "openai/o3",
          "openai/o4-mini",
          "openai/gpt-5",
          "openai/gpt-5-mini",
