{
  "suite": "winner",
  "target": "tryaii.monitor.winner.pick_winner / routed_model (+ reachable, native_model_id)",
  "cases": [
    {
      "name": "band-cheaper-openai-dynamic",
      "description": "The first ranked model with quality >= anchor-0.05 and blended price <= the anchor's wins; dynamic on an openai client sends its native id.",
      "input": {
        "provider": "openai",
        "mode": "dynamic",
        "anchor": "openai/gpt-5.5",
        "scores": [
          {
            "modelId": "openai/gpt-5.4",
            "finalScore": 0.91,
            "qualityScore": 0.8
          },
          {
            "modelId": "anthropic/claude-sonnet-4.5",
            "finalScore": 0.9,
            "qualityScore": 0.81
          },
          {
            "modelId": "openai/gpt-5.5",
            "finalScore": 0.88,
            "qualityScore": 0.82
          },
          {
            "modelId": "openai/gpt-5-mini",
            "finalScore": 0.85,
            "qualityScore": 0.7
          }
        ]
      },
      "expected": {
        "winner": {
          "winner": "openai/gpt-5.4",
          "rank": 1,
          "method": "band"
        },
        "winner_reachable": true,
        "routed_winner": {
          "winner": "openai/gpt-5.4",
          "rank": 1,
          "method": "band"
        },
        "routed": "openai/gpt-5.4",
        "model_to_send": "gpt-5.4",
        "route_status": null
      }
    },
    {
      "name": "unreachable-winner-recommended-not-routed",
      "description": "An anthropic winner on an openai client is recorded as the winner but never sent; since slice 2 (TS-170) dynamic sends the best-for-less model of the reachable ranking instead (routed_winner).",
      "input": {
        "provider": "openai",
        "mode": "dynamic",
        "anchor": "openai/gpt-5.5",
        "scores": [
          {
            "modelId": "anthropic/claude-sonnet-4.5",
            "finalScore": 0.92,
            "qualityScore": 0.81
          },
          {
            "modelId": "openai/gpt-5.4",
            "finalScore": 0.91,
            "qualityScore": 0.8
          },
          {
            "modelId": "openai/gpt-5.5",
            "finalScore": 0.88,
            "qualityScore": 0.82
          }
        ]
      },
      "expected": {
        "winner": {
          "winner": "anthropic/claude-sonnet-4.5",
          "rank": 1,
          "method": "band"
        },
        "winner_reachable": false,
        "routed_winner": {
          "winner": "openai/gpt-5.4",
          "rank": 1,
          "method": "band"
        },
        "routed": "openai/gpt-5.4",
        "model_to_send": "gpt-5.4",
        "route_status": null
      }
    },
    {
      "name": "openrouter-routes-cross-provider",
      "description": "The same ranking on an OpenRouter client is sent as the slug.",
      "input": {
        "provider": "openrouter",
        "mode": "dynamic",
        "anchor": "openai/gpt-5.5",
        "scores": [
          {
            "modelId": "anthropic/claude-sonnet-4.5",
            "finalScore": 0.92,
            "qualityScore": 0.81
          },
          {
            "modelId": "openai/gpt-5.4",
            "finalScore": 0.91,
            "qualityScore": 0.8
          },
          {
            "modelId": "openai/gpt-5.5",
            "finalScore": 0.88,
            "qualityScore": 0.82
          }
        ]
      },
      "expected": {
        "winner": {
          "winner": "anthropic/claude-sonnet-4.5",
          "rank": 1,
          "method": "band"
        },
        "winner_reachable": true,
        "routed_winner": {
          "winner": "anthropic/claude-sonnet-4.5",
          "rank": 1,
          "method": "band"
        },
        "routed": "anthropic/claude-sonnet-4.5",
        "model_to_send": "anthropic/claude-sonnet-4.5",
        "route_status": null
      }
    },
    {
      "name": "anchor-is-best-at-its-price",
      "description": "A better but pricier model does not qualify; the anchor is the winner (method anchor) and nothing is routed.",
      "input": {
        "provider": "openai",
        "mode": "dynamic",
        "anchor": "openai/gpt-5.5",
        "scores": [
          {
            "modelId": "anthropic/claude-fable-5.1",
            "finalScore": 0.95,
            "qualityScore": 0.9
          },
          {
            "modelId": "openai/gpt-5.5",
            "finalScore": 0.88,
            "qualityScore": 0.82
          },
          {
            "modelId": "openai/gpt-5.4",
            "finalScore": 0.8,
            "qualityScore": 0.7
          }
        ]
      },
      "expected": {
        "winner": {
          "winner": "openai/gpt-5.5",
          "rank": 2,
          "method": "anchor"
        },
        "winner_reachable": true,
        "routed_winner": {
          "winner": "openai/gpt-5.5",
          "rank": 1,
          "method": "anchor"
        },
        "routed": null,
        "model_to_send": null,
        "route_status": null
      }
    },
