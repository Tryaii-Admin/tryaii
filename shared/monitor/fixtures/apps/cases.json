{
  "suite": "apps",
  "description": "stdout/stderr/exit goldens and the request log of `tryaii apps` (SPEC §7) against canned HTTP answers (SPEC §6.3).",
  "cases": [
    {
      "name": "missing-verb",
      "description": "SPEC §7.1: no verb is a usage error.",
      "input": {
        "argv": [
          "apps"
        ]
      },
      "expected": {
        "stdout_golden": "missing-verb.stdout.golden.txt",
        "stderr": "error: missing apps verb. Run \"tryaii help apps\".\n",
        "exit_code": 2,
        "requests": []
      }
    },
    {
      "name": "unknown-verb",
      "description": "SPEC §7.1: an unknown verb is a usage error.",
      "input": {
        "argv": [
          "apps",
          "delete"
        ]
      },
      "expected": {
        "stdout_golden": "unknown-verb.stdout.golden.txt",
        "stderr": "error: unknown apps verb: delete. Run \"tryaii help apps\".\n",
        "exit_code": 2,
        "requests": []
      }
    },
    {
      "name": "unknown-option",
      "description": "SPEC §7.1: an option another verb owns is unknown here.",
      "input": {
        "argv": [
          "apps",
          "list",
          "--new"
        ],
        "signed_in": true
      },
      "expected": {
        "stdout_golden": "unknown-option.stdout.golden.txt",
        "stderr": "error: unknown option: --new. Run \"tryaii help apps\".\n",
        "exit_code": 2,
        "requests": []
      }
    },
    {
      "name": "not-signed-in",
      "description": "SPEC §7.2: user verbs need tryaii login; no request is made.",
      "input": {
        "argv": [
          "apps",
          "list"
        ]
      },
      "expected": {
        "stdout_golden": "not-signed-in.stdout.golden.txt",
        "stderr": "error: not signed in (run tryaii login)\n",
        "exit_code": 1,
        "requests": []
      }
    },
    {
      "name": "list-table",
      "description": "SPEC §7.2: one row per app; numbers right-aligned.",
      "input": {
        "argv": [
          "apps",
          "list"
        ],
        "signed_in": true,
        "http": {
          "GET /v1/apps": [
            {
              "status": 200,
              "body": {
                "apps": [
                  {
                    "app_id": "app_abcdefghijkl",
                    "name": "shop",
                    "owner_user_id": "google-sub-1",
                    "created_at": "2026-10-12T08:00:00.000Z",
                    "deleted_at": null,
                    "calls_24h": 1234,
                    "cost_24h_usd": 1.234567,
                    "savings_24h_usd": 0.5,
                    "last_event_at": "2026-10-12T08:59:00.000Z",
                    "processes": 3,
                    "keys_active": 2
                  },
                  {
                    "app_id": "app_mnopqrstuvwx",
                    "name": "internal tools",
                    "owner_user_id": "google-sub-1",
                    "created_at": "2026-10-12T08:30:00.000Z",
                    "deleted_at": null,
                    "calls_24h": 0,
                    "cost_24h_usd": 0,
                    "savings_24h_usd": 0,
                    "last_event_at": null,
                    "processes": 0,
                    "keys_active": 1
                  }
                ]
              }
            }
          ]
        }
      },
      "expected": {
        "stdout_golden": "list-table.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0,
        "requests": [
          {
            "method": "GET",
            "path": "/v1/apps",
            "query": null,
            "auth": "bearer",
            "body": null
          }
        ]
      }
    },
    {
      "name": "list-empty",
      "description": "SPEC §7.2: no apps yet.",
      "input": {
        "argv": [
          "apps",
          "list"
        ],
        "signed_in": true,
        "http": {
          "GET /v1/apps": [
            {
              "status": 200,
              "body": {
                "apps": []
              }
            }
          ]
        }
      },
      "expected": {
        "stdout_golden": "list-empty.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0,
        "requests": [
          {
            "method": "GET",
            "path": "/v1/apps",
            "query": null,
            "auth": "bearer",
            "body": null
          }
        ]
      }
    },
