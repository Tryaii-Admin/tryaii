                    "keys_active": 1
                  }
                ]
              }
            }
          ]
        }
      },
      "expected": {
        "stdout_golden": "list-json.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0,
        "requests": [
          {
            "method": "GET",
            "path": "/v1/apps",
            "query": null,
            "auth": "bearer",
            "body": null
          }
        ]
      }
    },
    {
      "name": "list-session-expired",
      "description": "SPEC §7.2: a 401 on a user verb means the session ended.",
      "input": {
        "argv": [
          "apps",
          "list"
        ],
        "signed_in": true,
        "http": {
          "GET /v1/apps": [
            {
              "status": 401,
              "body": {
                "error": "invalid_token"
              }
            }
          ]
        }
      },
      "expected": {
        "stdout_golden": "list-session-expired.stdout.golden.txt",
        "stderr": "error: session expired or revoked (run tryaii login)\n",
        "exit_code": 1,
        "requests": [
          {
            "method": "GET",
            "path": "/v1/apps",
            "query": null,
            "auth": "bearer",
            "body": null
          }
        ]
      }
    },
    {
      "name": "list-network-failure",
      "description": "SPEC §7.2: a transport failure names the API base.",
      "input": {
        "argv": [
          "apps",
          "list"
        ],
        "signed_in": true,
        "http": {
          "GET /v1/apps": [
            {
              "network": true
            }
          ]
        }
      },
      "expected": {
        "stdout_golden": "list-network-failure.stdout.golden.txt",
        "stderr": "error: could not reach https://api.tryaii.test\n",
        "exit_code": 1,
        "requests": [
          {
            "method": "GET",
            "path": "/v1/apps",
            "query": null,
            "auth": "bearer",
            "body": null
          }
        ]
      }
    },
    {
      "name": "list-server-error",
      "description": "SPEC §7.2: other errors print the error code (and detail).",
      "input": {
        "argv": [
          "apps",
          "list"
        ],
        "signed_in": true,
        "http": {
          "GET /v1/apps": [
            {
              "status": 500,
              "body": {
                "error": "internal",
                "detail": "try later"
              }
            }
          ]
        }
      },
      "expected": {
        "stdout_golden": "list-server-error.stdout.golden.txt",
        "stderr": "error: internal: try later\n",
        "exit_code": 1,
        "requests": [
          {
            "method": "GET",
            "path": "/v1/apps",
            "query": null,
            "auth": "bearer",
            "body": null
          }
        ]
      }
    },
    {
      "name": "create-ok",
      "description": "SPEC §7.2: create = the app, then its 'default' key; the key is printed once with a warning on stderr.",
      "input": {
        "argv": [
          "apps",
          "create",
          "shop"
        ],
        "signed_in": true,
        "http": {
          "POST /v1/apps": [
            {
              "status": 201,
              "body": {
                "app_id": "app_newapp00001",
                "name": "shop",
                "owner_user_id": "google-sub-1",
                "created_at": "2026-10-12T09:00:00.000Z",
                "deleted_at": null
              }
            }
          ],
          "POST /v1/apps/app_newapp00001/keys": [
            {
              "status": 201,
              "body": {
                "key_id": "k1a2b3c4d5e6",
                "key": "tryaii_k1a2b3c4d5e6_fixtureSecretfixtureSecretfixtureSecretfixt",
                "label": "default",
                "created_at": "2026-10-12T09:00:00.000Z"
              }
            }
          ]
        }
      },
      "expected": {
        "stdout_golden": "create-ok.stdout.golden.txt",
        "stderr": "warning: this is the only time the full key is shown; store it now (e.g. as TRYAII_API_KEY)\n",
        "exit_code": 0,
        "requests": [
          {
            "method": "POST",
            "path": "/v1/apps",
            "query": null,
            "auth": "bearer",
            "body": {
              "name": "shop"
            }
          },
          {
            "method": "POST",
            "path": "/v1/apps/app_newapp00001/keys",
            "query": null,
            "auth": "bearer",
            "body": {
              "label": "default"
            }
          }
        ]
      }
    },
    {
      "name": "create-json",
