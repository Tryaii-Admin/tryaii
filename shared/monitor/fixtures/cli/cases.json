{
  "suite": "cli",
  "description": "stdout/stderr/exit goldens of `tryaii monitor` (SPEC.md §5). Each case runs in a fresh temp data dir with the named corpus stores staged under <tmp>/monitor/<store>/; `env` is merged into the process environment. Both CLIs must reproduce every golden byte for byte.",
  "cases": [
    {
      "name": "status-shop",
      "description": "Human status for one app: table, per-process files, totals; a pinned process with no calls still shows.",
      "input": {
        "argv": [
          "monitor",
          "status",
          "--now",
          "2026-10-11T12:00:00Z"
        ],
        "copy_store": [
          "shop"
        ]
      },
      "expected": {
        "stdout_golden": "status-shop.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0
      }
    },
    {
      "name": "status-two-apps",
      "description": "Without --app every app prints its own block, separated by a blank line.",
      "input": {
        "argv": [
          "monitor",
          "status",
          "--now",
          "2026-10-11T12:00:00Z"
        ],
        "copy_store": [
          "shop",
          "web"
        ]
      },
      "expected": {
        "stdout_golden": "status-two-apps.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0
      }
    },
    {
      "name": "status-json-app",
      "description": "--app --json prints the single status document; --since 7d widens the window.",
      "input": {
        "argv": [
          "monitor",
          "status",
          "--app",
          "shop",
          "--since",
          "7d",
          "--now",
          "2026-10-11T12:00:00Z",
          "--json"
        ],
        "copy_store": [
          "shop"
        ]
      },
      "expected": {
        "stdout_golden": "status-json-app.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0
      }
    },
    {
      "name": "status-json-all",
      "description": "--json without --app prints a list of status documents, one per app.",
      "input": {
        "argv": [
          "monitor",
          "status",
          "--now",
          "2026-10-11T12:00:00Z",
          "--json"
        ],
        "copy_store": [
          "shop",
          "web"
        ]
      },
      "expected": {
        "stdout_golden": "status-json-all.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0
      }
    },
    {
      "name": "status-empty-window",
      "description": "A window with no events still lists configured/pinned processes with zero calls.",
      "input": {
        "argv": [
          "monitor",
          "status",
