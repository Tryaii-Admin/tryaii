        ],
        "copy_store": [
          "shop"
        ]
      },
      "expected": {
        "stdout_golden": "status-empty-window.stdout.golden.txt",
        "stderr": null,
        "exit_code": 0
      }
    },
    {
      "name": "status-env-mode-override",
