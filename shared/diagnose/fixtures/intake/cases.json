{
  "suite": "intake",
  "target": "tryaii.diagnose.intake.normalize_inventory",
  "cases": [
    {
      "name": "bare-array",
      "description": "SPEC §2.0: a bare array of sites is a valid inventory; defaults fall back (output_tokens 500, calls_per_day null).",
      "input": {
        "data": [
          {
            "file": "src/app.py",
            "line": 12,
            "prompt": "Explain how tides work."
          }
        ]
      },
      "expected": {
        "defaults": {
          "calls_per_day": null,
          "output_tokens": 500
        },
        "sites": [
          {
            "site_id": "src/app.py:12",
            "index": 0,
            "file": "src/app.py",
            "line": 12,
            "prompt": "Explain how tides work.",
            "provider": null,
            "model": null,
            "calls_per_day": null,
            "output_tokens": null,
            "notes": null,
            "classification": null
          }
        ],
        "skipped": []
      }
    },
    {
      "name": "coercions",
      "description": "SPEC §2.0: integer strings and integral floats coerce for line/output_tokens; numeric strings coerce for calls_per_day; invalid values are simply absent.",
      "input": {
        "data": {
          "version": 1,
          "defaults": {
            "calls_per_day": "1500",
            "output_tokens": 256.0
          },
          "sites": [
            {
              "file": "  src/a.py  ",
              "line": "42",
              "prompt": "hello",
              "calls_per_day": 12.5,
              "output_tokens": "300"
            },
            {
              "file": "src/b.py",
              "line": 7.0,
              "prompt": "hello",
              "calls_per_day": "lots",
              "output_tokens": -5,
              "provider": "   ",
              "model": ""
            }
          ]
        }
      },
      "expected": {
        "defaults": {
          "calls_per_day": 1500,
          "output_tokens": 256
        },
        "sites": [
          {
            "site_id": "src/a.py:42",
            "index": 0,
            "file": "src/a.py",
            "line": 42,
            "prompt": "hello",
            "provider": null,
            "model": null,
            "calls_per_day": 12.5,
            "output_tokens": 300,
            "notes": null,
            "classification": null
          },
          {
            "site_id": "src/b.py:7",
            "index": 1,
            "file": "src/b.py",
            "line": 7,
            "prompt": "hello",
            "provider": null,
            "model": null,
            "calls_per_day": null,
            "output_tokens": null,
            "notes": null,
            "classification": null
          }
        ],
        "skipped": []
      }
    },
    {
      "name": "skip-reasons",
      "description": "SPEC §2.0: non-object sites and sites without usable file/line are skipped with a reason, never guessed.",
      "input": {
        "data": {
          "sites": [
            "just a string",
            {
              "line": 3,
              "prompt": "no file"
            },
            {
              "file": "a.py",
              "prompt": "no line"
            },
            {
              "file": "a.py",
              "line": 0,
              "prompt": "line below 1"
            },
            {
              "file": "a.py",
              "line": 9,
              "prompt": "survivor"
            }
          ]
        }
      },
      "expected": {
        "defaults": {
          "calls_per_day": null,
          "output_tokens": 500
        },
        "sites": [
          {
            "site_id": "a.py:9",
            "index": 4,
            "file": "a.py",
            "line": 9,
            "prompt": "survivor",
            "provider": null,
            "model": null,
            "calls_per_day": null,
            "output_tokens": null,
            "notes": null,
            "classification": null
          }
        ],
        "skipped": [
          {
            "index": 0,
            "reason": "site is not an object"
          },
          {
            "index": 1,
            "reason": "missing file"
          },
          {
            "index": 2,
            "reason": "missing or invalid line"
          },
          {
            "index": 3,
            "reason": "missing or invalid line"
          }
        ]
      }
    },
