{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "diagnose inventory + findings shapes",
  "description": "Documentation-grade schema for the two diagnose JSON documents. The inventory is AGENT-WRITTEN and deliberately lenient (see SPEC.md §2.0 for the exact coercion/degradation rules — this schema describes the ideal shape, not the accepted superset). The findings document is MACHINE-GENERATED by analyze_inventory and frozen byte-for-byte in fixtures.",
  "definitions": {
    "inventory": {
      "type": "object",
      "required": ["sites"],
      "properties": {
        "version": { "const": 1 },
        "defaults": {
          "type": "object",
          "properties": {
            "calls_per_day": { "type": "number", "exclusiveMinimum": 0 },
            "output_tokens": { "type": "number", "exclusiveMinimum": 0, "default": 500 }
          }
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line"],
            "properties": {
              "id": { "type": "string", "description": "Stable key for cross-run deltas; falls back to '<file>:<line>'." },
              "file": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 },
              "prompt": { "description": "String or cachelint prompt object {system?, tools?, messages?}." },
              "provider": { "type": "string", "description": "openai | anthropic | gemini | xai | openrouter | bedrock | vertex (cachelint aliases accepted)." },
              "model": { "type": "string" },
              "calls_per_day": { "type": "number", "exclusiveMinimum": 0 },
              "output_tokens": { "type": "number", "exclusiveMinimum": 0 },
              "notes": { "type": "string" },
              "_classification": {
                "type": "object",
                "description": "Injection seam (tests/advanced): precomputed classifier output; bypasses live routing for this site.",
                "required": ["benchmark_similarities"],
                "properties": {
                  "benchmark_similarities": { "type": "object", "additionalProperties": { "type": "number" } },
                  "broad_category": { "type": "string" },
                  "subcategory": { "type": "string" },
                  "confidence": { "type": "number" },
                  "difficulty": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "check_status": { "enum": ["ok", "finding", "insufficient_data", "skipped"] },
    "findings": {
      "type": "object",
      "description": "Output of analyze_inventory. Field ORDER is contractual (SPEC.md §1.3/§3); see SPEC.md §2 for each check's payload.",
      "required": ["version", "run_id", "generated_at", "tool", "interview", "inventory", "sites", "summary"],
      "properties": {
        "version": { "const": 1 },
        "run_id": { "type": "string" },
        "generated_at": { "type": "string" },
        "tool": { "type": "object", "properties": { "name": { "const": "tryaii" }, "version": { "type": "string" } } },
        "interview": {
          "type": "object",
          "properties": {
            "priorities": { "type": "object", "properties": { "quality": {}, "cost": {}, "speed": {} } },
            "goal": { "type": ["string", "null"] },
            "defaults": { "type": "object" }
          }
        },
        "inventory": {
          "type": "object",
          "properties": {
            "site_count": { "type": "integer" },
            "skipped": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "reason": { "type": "string" } } } }
          }
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "site_id": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "provider": { "type": ["string", "null"] },
              "model": { "type": ["string", "null"] },
              "resolved_model_id": { "type": ["string", "null"] },
              "notes": { "type": "string" },
              "checks": {
                "type": "object",
                "properties": {
                  "model_fit": { "type": "object" },
                  "cache_readiness": { "type": "object" },
                  "cost_exposure": { "type": "object" },
                  "hygiene": { "type": "object" }
                }
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "description": "The redacted layer — designed as the future upload payload. MUST NOT contain code, prompts, file paths, reasoning text, or the goal text.",
          "required": ["schema", "run_id", "generated_at", "site_count", "goal_present", "priorities", "check_status_counts", "cache_verdict_counts", "totals", "swap_stats"],
          "properties": {
            "schema": { "const": "tryaii.diagnose.summary/1" }
          }
        }
      }
    }
  }
}
