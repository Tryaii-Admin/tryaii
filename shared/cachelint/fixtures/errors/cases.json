{
  "suite": "errors",
  "target": "api.analyze (error message)",
  "cases": [
    {
      "name": "err-top-level-not-object",
      "description": "non-object top level",
      "input": {
        "data": 42
      },
      "expected": {
        "error": "Input must be an object, a list of objects, or {\"inputs\": [...]}"
      }
    },
    {
      "name": "err-bare-string-item",
      "description": "bare string element with wrap-it hint",
      "input": {
        "data": [
          "bare string"
        ]
      },
      "expected": {
        "error": "input #0 is a bare string — wrap it: {\"prompt\": \"...\", \"llm\": {\"provider\": \"...\", \"name\": \"...\"}}"
      }
    },
    {
      "name": "err-missing-prompt",
      "description": "object without a prompt field",
      "input": {
        "data": [
          {
            "llm": {
              "provider": "anthropic",
              "name": "claude-fable-5"
            }
          }
        ]
      },
      "expected": {
        "error": "input #0: expected an object with a 'prompt' field"
      }
    },
    {
      "name": "err-missing-provider",
      "description": "prompt without llm.provider",
      "input": {
        "data": [
          {
            "prompt": "x"
          }
        ]
      },
      "expected": {
        "error": "input #0: missing llm.provider"
      }
    },
    {
      "name": "err-unknown-provider",
      "description": "fix n: plain-quoted unknown provider message with sorted known list",
      "input": {
        "data": {
          "prompt": "x",
          "llm": {
            "provider": "azure",
            "name": "gpt-4"
          }
        }
      },
      "expected": {
        "error": "Unknown provider 'azure'. Known: anthropic, bedrock, gemini, openai, openrouter, vertex, xai"
      }
    },
    {
      "name": "err-bad-prompt-type",
      "description": "prompt neither string nor object",
      "input": {
        "data": {
          "prompt": 42,
          "llm": {
            "provider": "anthropic",
            "name": "claude-fable-5"
          }
        }
      },
      "expected": {
        "error": "prompt must be a string or an object with system/messages/tools"
      }
    },
    {
      "name": "err-index-interpolation",
      "description": "second item bad -> message says input #1",
      "input": {
        "data": [
          {
            "prompt": "x",
            "llm": {
              "provider": "anthropic",
              "name": "claude-fable-5"
            }
          },
          {
            "prompt": "y"
          }
        ]
      },
      "expected": {
        "error": "input #1: missing llm.provider"
      }
    }
  ]
}
