{
  "suite": "tokenize",
  "target": "tokenizers.count_tokens",
  "cases": [
    {
      "name": "tok-empty",
      "description": "empty text -> 0, method 'empty', exact",
      "input": {
        "text": "",
        "provider_key": "openai",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-openai-exact-ascii",
      "description": "o200k_base exact count (tiktoken required)",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "openai",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-openai-special-token",
      "description": "special tokens encode as plain text (disallowed_special=() / encode(text, [], []))",
      "input": {
        "text": "before <|endoftext|> after",
        "provider_key": "openai",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-openai-unicode",
      "description": "Hebrew + emoji exact o200k count (P1 spike case, frozen)",
      "input": {
        "text": "שלום עולם 🚀 hello",
        "provider_key": "openai",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-xai-approx",
      "description": "same encoder, exact=false, xai approximation note",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "xai",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-openrouter-upstream-openai",
      "description": "openrouter with openai upstream -> tiktoken path, exact",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "openrouter",
        "upstream": "openai"
      },
      "expected": null
    },
    {
      "name": "tok-openrouter-upstream-anthropic",
      "description": "openrouter with anthropic upstream -> heuristic 3.5",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "openrouter",
        "upstream": "anthropic"
      },
      "expected": null
    },
    {
      "name": "tok-openrouter-no-upstream",
      "description": "openrouter unknown upstream -> heuristic 4.0 + upstream-dependent note",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "openrouter",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-bedrock-openai-upstream",
      "description": "bedrock with openai upstream -> tiktoken path (public count_tokens surface)",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "bedrock",
        "upstream": "openai"
      },
      "expected": null
    },
    {
      "name": "tok-anthropic-heuristic",
      "description": "anthropic heuristic 3.5 + exact-count API note",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "anthropic",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-anthropic-nonascii-switch",
      "description": "fix k: >30% non-ASCII drops the rate to 2.6 and the label reports 2.6",
      "input": {
        "text": "אתה עוזר לוגיסטיקה. ענה עם קוד המחסן, שם המוביל, וזמן המשלוח בימי עסקים. העדף משלוח יבשתי כאשר העלות חשובה. אתה עוזר לוגיסטיקה. ענ",
        "provider_key": "anthropic",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-nonascii-at-threshold",
      "description": "exactly 30% non-ASCII does NOT switch (strict >)",
      "input": {
        "text": "אבגabcdefg",
        "provider_key": "anthropic",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-nonascii-above-threshold",
      "description": "just above 30% switches to 2.6",
      "input": {
        "text": "אבגדabcdef",
        "provider_key": "anthropic",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-round-half-even-down",
      "description": "10 cp / 4.0 = 2.5 -> 2 (half-even)",
      "input": {
        "text": "abcdefghij",
        "provider_key": "gemini",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-round-half-even-up",
      "description": "14 cp / 4.0 = 3.5 -> 4 (half-even)",
      "input": {
        "text": "abcdefghijklmn",
        "provider_key": "gemini",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-min-one",
      "description": "single char -> max(1, ...) floor",
      "input": {
        "text": "a",
        "provider_key": "anthropic",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-codepoint-length",
      "description": "astral emoji count as 1 cp each; 100% non-ASCII also exercises the 2.6 switch on bedrock",
      "input": {
        "text": "😀😀",
        "provider_key": "bedrock",
        "upstream": null
      },
      "expected": null
    },
    {
      "name": "tok-vertex-rate",
      "description": "vertex heuristic 4.0 + countTokens note",
      "input": {
        "text": "The quick brown fox jumps over the lazy dog.",
        "provider_key": "vertex",
        "upstream": null
      },
      "expected": null
    }
  ]
}
